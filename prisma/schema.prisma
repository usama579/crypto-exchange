generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                @id @default(cuid())
  email                         String                @unique
  firstName                     String
  lastName                      String
  password                      String
  referralCode                  String?               @unique
  referredBy                    String?
  isEmailVerified               Boolean               @default(false)
  emailVerificationToken        String?               @unique
  emailVerificationTokenExpires DateTime?
  passwordResetToken            String?               @unique
  passwordResetTokenExpires     DateTime?
  mobileNumber                  String?
  idCardFront                   String?
  idCardBack                    String?
  isProfileCompleted            Boolean               @default(false)
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  copyTradingPositions          CopyTradingPosition[]
  lockedBalances                LockedBalance[]
  referrals                     Referral[]            @relation("ReferrerToReferrals")
  tradingOrders                 TradingOrder[]
  tradingPositions              TradingPosition[]
  transactions                  Transaction[]
  referredByUser                User?                 @relation("UserReferrals", fields: [referredBy], references: [id])
  referredUsers                 User[]                @relation("UserReferrals")
  wallets                       Wallet[]

  @@map("users")
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String
  symbol       String
  name         String
  address      String        @unique
  balance      String        @default("0")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@map("wallets")
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  walletId      String
  txHash        String?
  type          String
  status        String
  amount        String
  symbol        String
  fromAddress   String?
  toAddress     String?
  confirmations Int      @default(0)
  networkFee    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([txHash, symbol])
  @@map("transactions")
}

model Referral {
  id                 String   @id @default(cuid())
  referrerId         String
  referredUserId     String
  status             String   @default("PENDING")
  rewardAmount       String   @default("100")
  isUnlocked         Boolean  @default(false)
  requiredReferrals  Int      @default(2)
  completedReferrals Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  referrer           User     @relation("ReferrerToReferrals", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredUserId])
  @@map("referrals")
}

model LockedBalance {
  id         String    @id @default(cuid())
  userId     String
  amount     String
  currency   String    @default("USDT")
  reason     String
  isLocked   Boolean   @default(true)
  unlockedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("locked_balances")
}

model ReferralDeposit {
  id            String   @id @default(cuid())
  userId        String
  referralId    String?
  transactionId String
  amount        String
  currency      String
  isProcessed   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("referral_deposits")
}

model TradingPosition {
  id               String    @id @default(cuid())
  userId           String
  type             String
  symbol           String
  side             String
  amount           String
  entryPrice       String
  currentPrice     String?
  margin           String?
  leverage         Int?
  liquidationPrice String?
  stopLoss         String?
  takeProfit       String?
  pnl              String    @default("0")
  status           String    @default("OPEN")
  openedAt         DateTime  @default(now())
  closedAt         DateTime?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trading_positions")
}

model CopyTradingPosition {
  id            String    @id @default(cuid())
  userId        String
  traderId      String
  traderName    String
  copyAmount    String
  profit        String    @default("0")
  profitPercent String    @default("0")
  status        String    @default("ACTIVE")
  startedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  proTrader     ProTrader @relation("ProTraderCopies", fields: [traderId], references: [id])
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("copy_trading_positions")
}

model TradingOrder {
  id           String   @id @default(cuid())
  userId       String
  symbol       String
  type         String
  side         String
  amount       String
  price        String?
  stopPrice    String?
  status       String   @default("PENDING")
  filledAmount String   @default("0")
  fees         String   @default("0")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trading_orders")
}

model ProTrader {
  id            String                @id @default(cuid())
  name          String                @unique
  email         String                @unique
  avatar        String
  verified      Boolean               @default(false)
  followers     Int                   @default(0)
  totalReturn   String
  monthlyReturn String
  winRate       String
  riskLevel     String
  minCopyAmount String                @default("50")
  description   String
  tradingPairs  String
  joinedDate    DateTime              @default(now())
  isActive      Boolean               @default(true)
  lastActiveAt  DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  copyPositions CopyTradingPosition[] @relation("ProTraderCopies")
  trades        ProTraderTrade[]

  @@map("pro_traders")
}

model ProTraderTrade {
  id            String    @id @default(cuid())
  traderId      String
  symbol        String
  side          String
  amount        String
  entryPrice    String
  exitPrice     String?
  profit        String    @default("0")
  profitPercent String    @default("0")
  status        String    @default("OPEN")
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  updatedAt     DateTime  @updatedAt
  trader        ProTrader @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@map("pro_trader_trades")
}
